# Android delivery note: notifications that do not name a `channel` are delivered on the
# Home Assistant companion app's *default* channel. If that channel is disabled on the phone,
# Android discards them silently - Home Assistant still reports success and nothing arrives.
# Both keys below are optional and default to `weather_alerts` / `high`.
#   notification_channel: name of the Android notification channel to deliver on.
#                         Set to an empty value to send no channel (not recommended).
#   notification_priority: "high" sets priority + ttl:0 so alerts are not deferred by Doze.
#                          Set to an empty value to send at normal priority.
#
# Display names: use `alert_name:`, NOT `name:` — see the note on the first app below.
# YAML key, so the display name is always the app name. Tracked as backlog T-53.

WindAlarm:
  module: i1_weather_wind_alarm
  class: WeatherWindAlarm
  device_id: "8a9282bcd3f3555085c7dd8c3f"
  notification_channel: weather_alerts
  notification_priority: high

  # The unit the FORECAST PROVIDER reports. The limit bands below are always
  # m/s, which is what Sweden uses for wind; this only says what to convert
  # from. Home Assistant reports whatever its weather integration is set to --
  # check `wind_speed_unit` on the weather entity. Optional, defaults to km/h.
  #
  # Getting this wrong misreports storms rather than failing: until 2026-08-31
  # the raw number was used as if it were m/s, so a 36 km/h breeze (10 m/s)
  # announced itself as "Jätteblåsigt!" and every band but the top one fired at
  # roughly a third of its intended wind. An unknown value now refuses to start
  # (policy D1) rather than guessing.
  #
  # Accepted: m/s, km/h, mph, kn
  wind_speed_unit: km/h

  # Policy D2 quiet hours, severity-aware.
  #
  # A band whose msg_cooldown is at or BELOW quiet_bypass_cooldown is treated as
  # critical and delivered whatever the hour - STORM VARNING! at 02:00 should
  # wake you. Everything milder is held until the window opens. With the live
  # config that means the 3600s bands get through and the 21600s / 86400s bands
  # wait, which is why severity does not need a second flag: msg_cooldown
  # already encodes it.
  #
  # Holding does NOT consume the band's cooldown, so a held alert lands when the
  # window opens rather than a further interval later.
  quiet_hours: true
  quiet_start: 22               # hour 0-23, inclusive
  quiet_end: 7                  # hour 0-23, exclusive
  quiet_bypass_cooldown: 3600   # bands at or below this are critical
  recipients:
    - notification_target: mobile_app_iphone_27
      startup_message: true
      time_of_day: "18:15"
  # AppDaemon reserves `name:` — it injects the app's YAML key there and
  # overwrites whatever you write, so `name: "Vind"` was silently discarded and
  # every alert was titled "WindAlarm". Verified live 2026-09-05. Use
  # `alert_name:` instead; it falls back to the app key if unset. (T-53)
  alert_name: "Vind"
  limits:
    - lt: 20
      gt: 10
      message: "Lite blåsigt"
      msg_cooldown: 86400
    - lt: 30
      gt: 20
      message: "Mycket blåsigt"
      msg_cooldown: 86400
    - lt: 40
      gt: 30
      message: "Jätteblåsigt!"
      msg_cooldown: 21600
    - lt: 1000
      gt: 40
      message: "STORM VARNING!"
      msg_cooldown: 3600
RainAlarm:
  module: i1_weather_rain_alarm
  class: WeatherRainAlarm
  device_id: "8a9282bcd3f3555085c7dd8c3f"
  recipients:
    - notification_target: mobile_app_iphone_27
      startup_message: true
      time_of_day: "18:15"
    - notification_target: mobile_app_iphone_27_2
      startup_message: false
      time_of_day: "12:15"
  alert_name: "Regn"
  limits:
    - lt: 7.5
      gt: 2.5
      message: "Måttligt regn"
      msg_cooldown: 86400
    - lt: 15
      gt: 7.5
      message: "Kraftigt regn"
      msg_cooldown: 21600
    - lt: 1000
      gt: 15
      message: "STARKT REGN!"
      msg_cooldown: 3600
TemperatureAlarm:
  module: i1_weather_temperature_alarm
  class: WeatherTemperatureAlarm
  device_id: "8a9282bcd3f3555085c7dd8c3f"
  recipients:
    - notification_target: mobile_app_iphone_27
      startup_message: true
      time_of_day: "18:15"
  alert_name: "Temperatur"
  limits:
    - lt: 0
      gt: -10
      message: "Mycket kallt!"
      msg_cooldown: 21600
    - lt: -10
      gt: -50
      message: "EXTREMT KALLT!"
      msg_cooldown: 3600
    - lt: 25
      gt: 20
      message: "Varmt"
      msg_cooldown: 86400
    - lt: 30
      gt: 25
      message: "Mycket varmt"
      msg_cooldown: 86400
    - lt: 35
      gt: 30
      message: "Hett!"
      msg_cooldown: 21600
    - lt: 1000
      gt: 35
      message: "EXTREMT HETT!"
      msg_cooldown: 3600
